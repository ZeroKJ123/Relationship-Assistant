APP_NAME="Любимость"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8086

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=homeassist
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

COMPOSE_PROJECT_NAME=homeassist
APP_PORT=8086
# Set to 0.0.0.0 only for access from a trusted local network.
APP_BIND_ADDRESS=127.0.0.1
FORWARD_DB_PORT=33070
VITE_PORT=5176
WWWUSER=501
WWWGROUP=20

TELEGRAM_ENABLED=false
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=

TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Enable after starting the realtime service from compose.workers.yaml.
REALTIME_ENABLED=false
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=realtime
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8089

# Optional owner-only panel. Store a bcrypt hash here, never the password.
ADMIN_PANEL_LOGIN=
ADMIN_PANEL_PASSWORD_HASH=
