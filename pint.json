{
    "preset": "laravel",
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules"
    ],
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "no_useless_else": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant",
                "property",
                "construct",
                "destruct",
                "magic",
                "phpunit",
                "method:abstract",
                "method:public:static",
                "method:public",
                "method:protected:static",
                "method:protected",
                "method:private:static",
                "method:private"
            ]
        }
    }
}
